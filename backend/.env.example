# Copy to .env and fill in values before starting the WAF

# JWT secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Admin password hash — generate with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('your_password'))"
ADMIN_PASSWORD_HASH=$2b$12$examplehashgoeshere

# Upstream application the WAF proxies to
TARGET_URL=http://localhost:8001

# Optional overrides
# ADMIN_USERNAME=admin
# CLASSIFICATION_THRESHOLD=0.5
# DB_PATH=backend/waf.db
# MODEL_PATH=model/saved/lstm_best.keras
# WAF_PORT=8080
